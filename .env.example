# Protect your backend with a long random value.
APP_ACCESS_KEY=replace-with-a-long-random-secret

# REQUIRED: URL of a real image-to-video/text-to-video API endpoint.
# Endpoint must accept JSON: prompt, image, ratio, duration, quality
# and return JSON containing videoUrl (a downloadable MP4 URL).
ENGINE_API_URL=
ENGINE_ACCESS_TOKEN=

OUTPUT_DIR=/data/generated
